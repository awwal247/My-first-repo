# ==========================================================
# ZenithOX OpenRouter Version Environment Variables
# ==========================================================

# OpenRouter API key (primary AI provider) — https://openrouter.ai/keys
# Used for all AI text modes. Groq is the fallback for vision/images.
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# Groq API key (required for vision fallback) — https://console.groq.com/
# Used for image analysis (Llama 4 Scout multimodal).
GROQ_API_KEY=your_groq_api_key_here

# --- Web search for Researcher mode (v2.1) -----------------
# Exa AI is the PRIMARY web-search provider — get your key at:
# https://exa.ai (Dashboard -> API Keys)
# Used for "deep research": Sources are automatically listed after
# every web-grounded answer.
EXA_API_KEY=your_exa_api_key_here

# Tavily API key — AUTOMATIC FALLBACK only, used if EXA_API_KEY is
# missing or an Exa request fails. Get your key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Flask secret key (auto-generated if not set, but set one for production)
FLASK_SECRET_KEY=

# Google OAuth (optional — enables "Continue with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Debug mode (optional)
FLASK_DEBUG=false

# ----------------------------------------------------------
# Supabase / PostgreSQL connection string (required)
#
# WHERE TO FIND IT:
# 1. Go to supabase.com/dashboard and click your PROJECT (not Account Settings)
# 2. In the left sidebar, click the gear icon (Settings) at the very bottom
# 3. Click "Database" under Project Settings
# 4. Scroll to "Connection Pooling" -> set mode to "Transaction"
# 5. Copy the URI (port 6543) — use this for Vercel
#
# LOCAL DEV (port 5432 — direct connection):
# DATABASE_URL=postgresql://postgres:@db..supabase.co:5432/postgres
#
# VERCEL / PRODUCTION (port 6543 — transaction pooler):
DATABASE_URL=postgresql://postgres.:@aws-0-.pooler.supabase.com:6543/postgres
